<Window x:Class="SnakeTimeKiller.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:snake="clr-namespace:SnakeTimeKiller;assembly=SnakeTimeKiller"
        Title="Snake Time Killer Demo"
        Width="900"
        Height="620"
        MinWidth="680"
        MinHeight="460"
        Loaded="OnLoaded"
        Background="#111827"
        FocusManager.FocusedElement="{Binding ElementName=Snake}">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Margin" Value="8,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Start" Click="StartButton_OnClick" />
                <Button Content="Pause" Click="PauseButton_OnClick" />
                <Button Content="Reset" Click="ResetButton_OnClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="{Binding ElementName=Snake, Path=Score, StringFormat='Score {0}'}"
                           FontWeight="SemiBold"
                           Margin="0,0,18,0" />

                <TextBlock Text="Rows" />
                <Slider x:Name="RowsSlider"
                        Minimum="8"
                        Maximum="40"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="16"
                        ValueChanged="RowsSlider_OnValueChanged" />
                <TextBlock x:Name="RowsValueText" MinWidth="24" />

                <TextBlock Text="Columns" Margin="12,0,0,0" />
                <Slider x:Name="ColumnsSlider"
                        Minimum="8"
                        Maximum="56"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="24"
                        ValueChanged="ColumnsSlider_OnValueChanged" />
                <TextBlock x:Name="ColumnsValueText" MinWidth="24" />

                <TextBlock Text="Tick" Margin="12,0,0,0" />
                <Slider x:Name="SpeedSlider"
                        Minimum="60"
                        Maximum="250"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="120"
                        ValueChanged="SpeedSlider_OnValueChanged" />
                <TextBlock x:Name="SpeedValueText" MinWidth="52" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="#020617"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8">
            <snake:SnakeGameControl x:Name="Snake"
                                    Rows="16"
                                    Columns="24"
                                    TickInterval="0:0:0.120"
                                    AutoStart="True"
                                    Margin="12"
                                    BoardBackgroundBrush="#0B1120"
                                    GridLineBrush="#172033"
                                    SnakeHeadBrush="#F8FAFC"
                                    SnakeBodyBrush="#2DD4BF"
                                    CargoLowBrush="#38BDF8"
                                    CargoMediumBrush="#FACC15"
                                    CargoHighBrush="#FB7185" />
        </Border>
    </Grid>
</Window>
